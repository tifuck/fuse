# Secrets only. Copy to .env (chmod 600); never commit it. Settings go in
# config.env (see config.env.example). install.sh writes both for you.

# Required. Signs sessions and encrypts stored provider credentials (48+ random
# characters). Changing it invalidates both.
APP_SECRET=replace-with-48-random-characters

# MariaDB connection; the URL carries the database password.
DATABASE_URL=mysql://fuse:PASSWORD@127.0.0.1:3306/fuse

# Docker only: password of the bundled MariaDB's 'fuse' user (hex).
#DB_PASSWORD=

# Optional site-wide llama.cpp backend key (its URL is LLAMA_BASE_URL in config.env).
#LLAMA_API_KEY=

# Optional extra web search source.
#BRAVE_SEARCH_API_KEY=

# Optional: raises the GitHub rate limit for skill installs.
#GITHUB_TOKEN=

# Optional non-expiring skills.sh catalog credential (not a 12h Vercel OIDC JWT).
#SKILLS_SH_TOKEN=

# Optional Web Push keys. Empty = data/vapid.json, generated on first use.
# Copy the existing values when moving them here: new keys break every
# existing push subscription.
#VAPID_PRIVATE_KEY=
#VAPID_PUBLIC_KEY=

# Optional SOCKS/HTTP proxy for ChatGPT OAuth (socks5h://user:pass@host:port).
#OPENAI_AUTH_PROXY=
