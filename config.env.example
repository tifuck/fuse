# Non-secret settings. Copy to config.env; secrets go in .env (see
# .env.example), which wins when both set a key. Every setting and its default
# is in app/config.py; these are the ones operators usually change.

# Server (read by start.sh)
HOST=0.0.0.0
PORT=8088
#FORWARDED_ALLOW_IPS=127.0.0.1
#LIMIT_CONCURRENCY=256

# Public HTTPS URL of this box: invite links, connector install lines and
# desktop update checks. Needs a trusted certificate.
#PUBLIC_BASE_URL=https://fuse.example.com
#TRUSTED_HOSTS=fuse.example.com

# Database pool size (shared with every other app on the MariaDB server).
#DATABASE_POOL_SIZE=48

# Open registration (default: invite-only after the first user).
#ALLOW_REGISTER=false
# Let users add SSH hosts on private (RFC1918) addresses.
#ALLOW_PRIVATE_HOSTS=false

# Optional site-wide llama.cpp backend (its key is LLAMA_API_KEY in .env).
#LLAMA_BASE_URL=

# Static assets: cache /static?v= URLs for a year (set false on a dev box).
#STATIC_IMMUTABLE=true
# Refresh pooled OAuth tokens. Only the instance that owns them may (false on dev).
#OAUTH_REFRESH_ENABLED=true

# Instance-wide cleanup ceilings in days (0 = off).
#RETENTION_FORCE_ARCHIVE_DAYS=0
#RETENTION_FORCE_DELETE_DAYS=0

# Bug-report triage pipeline.
#ISSUES_PIPELINE_ENABLED=false
#ISSUES_PIPELINE_MODEL=

# Context meter and compaction.
#CONTEXT_AUTO_COMPACT=true
#CONTEXT_SUMMARIZER_MODEL=
